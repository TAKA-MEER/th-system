# pi_serial_relay の systemd unit テンプレート。
# /etc/systemd/system/rpi-serial-relay.service としてラズパイに配置する。
#
# ESP32 の by-id パスはここに書かない。ラッパー rpi_serial_relay_run.sh が
# 「/dev/serial/by-id/ のうち LiDAR 以外の USB-UART」を ESP32 として自動で選ぶ
# （ESP32 を交換してもユニットの編集は要らない。2026-10-14、交換でシリアルIDが変わり
# 固定パスが消えて起動できなくなった事故の再発防止）。
# /dev/ttyUSB0 等の列挙順依存パスは使わない（RPLIDAR S1 も同じラズパイの USB-UART で、
# 列挙順は起動/挿抜のたびに入れ替わりうる）。LiDAR を交換したときだけ、ラッパー内の
# LiDAR ID（rplidar.service と同じもの）を直すこと。詳細は docs/network.md。
#
# 導入手順は docs/network.md「ラズパイ: pi_serial_relay の導入」参照。
[Unit]
Description=ESP32 serial <-> esp32_bridge WebSocket relay (TH system)
After=network.target
[Service]
Type=simple
User=mirs2602
# このラズパイに pip3 が入っていない(インターネット非接続)ため、
# pyserial/websockets は開発機で `pip3 download` した wheel を展開して
# ~/pi_relay_env/site-packages に置く運用にした(docs/network.md 参照)。
Environment=PYTHONPATH=/home/mirs2602/pi_relay_env/site-packages
# ポートを開き直すたびに HUPCL による DTR/RTS の再アサートで ESP32 が
# 誤って自動リセットされないよう、ラッパーが起動前に stty -hupcl をかける
# (pi_serial_relay.py 自体も open() 前に dtr/rts を明示的に落としている)。
# dialout 所属は導入手順(docs/network.md)で別途確認すること。
ExecStart=/home/mirs2602/rpi_serial_relay_run.sh
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
