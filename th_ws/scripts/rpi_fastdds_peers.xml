<?xml version="1.0" encoding="UTF-8" ?>
<!-- 正本: ラズパイの ~/fastdds_peers.xml（rplidar.service・rpi_speaker.service が FASTRTPS_DEFAULT_PROFILES_FILE で読む）。変えたら scp でラズパイへ送り、両サービスを再起動する。docs/network.md -->
<!-- ラズパイ AP 構成 (2026-08-20)。PC は 192.168.5.50。
     有線 (10.42.0.2) は SSH の退路として残すが、DDS は無線だけを使う。
     whiteList を入れないと eth0 経由に流れて測定にならない。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors><transport_descriptor>
    <transport_id>wlan_only</transport_id><type>UDPv4</type>
    <!-- 2026-11-19: SEDP の殺到で受信バッファがあふれていた。sysctl の rmem_max (8MB) とあわせて広げる -->
    <receiveBufferSize>4194304</receiveBufferSize>
    <interfaceWhiteList><address>192.168.5.1</address></interfaceWhiteList>
  </transport_descriptor></transport_descriptors>
  <participant profile_name="up" is_default_profile="true"><rtps>
    <userTransports><transport_id>wlan_only</transport_id></userTransports>
    <useBuiltinTransports>false</useBuiltinTransports>
    <builtin><initialPeersList>
      <locator><udpv4><address>192.168.5.50</address></udpv4></locator>
    </initialPeersList></builtin>
  </rtps></participant>
</profiles>
