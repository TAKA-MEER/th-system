<?xml version="1.0"?>
<robot name="th_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       TH ロボット URDF (CuGo v3i 仕様ベース)
       ─────────────────────────────────────────
       車体: 50cm × 50cm × 20cm
       ホイール半径: 0.0391m   ※ キャリブ後に更新
       ホイールベース: 0.39m    ※ キャリブ後に更新
       LiDAR: レーザーリンク高さ 0.105m (base_link 基準)
       ============================================================ -->

  <!-- ── パラメータ ─────────────────────────────────────────── -->
  <xacro:property name="body_length" value="0.50"/>   <!-- m 前後 -->
  <xacro:property name="body_width"  value="0.50"/>   <!-- m 左右 -->
  <xacro:property name="body_height" value="0.20"/>   <!-- m 上下 -->

  <xacro:property name="wheel_radius"    value="0.0391"/>
  <xacro:property name="wheel_width"     value="0.05"/>
  <xacro:property name="wheel_base"      value="0.39"/>   <!-- 左右ホイール間距離 -->

  <xacro:property name="lidar_height"    value="0.105"/>  <!-- base_link からの高さ -->
  <xacro:property name="lidar_radius"    value="0.04"/>
  <xacro:property name="lidar_thick"     value="0.04"/>

  <xacro:property name="body_mass"       value="8.0"/>    <!-- kg (暫定) -->
  <xacro:property name="wheel_mass"      value="0.3"/>

  <!-- ── インクルード ───────────────────────────────────────── -->
  <xacro:include filename="$(find th_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find th_description)/urdf/gazebo_plugins.xacro"/>

  <!-- ====================================================
       慣性テンソル ヘルパー
       ==================================================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${m/12*(x*x+z*z)}" iyz="0"
               izz="${m/12*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(3*r*r+h*h)}" ixy="0" ixz="0"
               iyy="${m/12*(3*r*r+h*h)}" iyz="0"
               izz="${m/2*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ====================================================
       ホイール マクロ
       ==================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} ${-body_height/2 + wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.5"/>
    </joint>

    <xacro:gazebo_material_dark_grey link="${prefix}_wheel"/>
  </xacro:macro>

  <!-- ====================================================
       リンク定義
       ==================================================== -->

  <!-- base_footprint: Nav2 が要求する仮想リンク（地面レベル） -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: 車体重心 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}"
                       x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>
  <xacro:gazebo_material_dark_grey link="base_link"/>

  <!-- ホイール (左右) -->
  <xacro:wheel prefix="left"  y_offset="${ wheel_base/2}"/>
  <xacro:wheel prefix="right" y_offset="${-wheel_base/2}"/>

  <!-- LiDAR リンク -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_thick}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_thick}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="0 0 ${body_height/2 + lidar_thick/2}" rpy="0 0 0"/>
  </joint>
  <xacro:gazebo_material_orange link="laser_link"/>

  <!-- IMU リンク (オプション) -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
