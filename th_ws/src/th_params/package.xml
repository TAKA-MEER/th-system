<?xml version="1.0"?>
<package format="3">
  <name>th_params</name>
  <version>0.1.0</version>
  <description>パラメータの実体化。registry.yaml ＋ 純粋な derive/assertions/export（WP-PARAM-01）。
    scripts/params_audit.py だけが rclpy に依存する監査ノード（WP-PARAM-02）</description>
  <maintainer email="dev@example.com">TH Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>std_srvs</depend>
  <depend>th_system_msgs</depend>
  <!-- A13（N-15）: export.py が th_state.zones.LIMIT_STRICTNESS を読んで
       registry.yaml の解決済みの数値の昇順と一致することを検査するため -->
  <depend>th_state</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
