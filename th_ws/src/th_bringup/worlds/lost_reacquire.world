<?xml version="1.0"?>
<!--
  lost_reacquire.world
  ────────────────────
  人物ロスト・再捕捉シナリオ (scenario:=lost_reacquire) 用ワールド。
  内寸 12×8 m の部屋に自立遮蔽板 3 枚 (2.0×0.15×2.0 m) を配置。
  gazebo_person_relay の遮蔽(LOS)チェックと組み合わせて、
  人物が板の裏に回る → is_lost → 捜索 → 再捕捉 の流れを再現する。

  ★ 遮蔽板の端点座標は config/scenarios/lost_reacquire.yaml の
    occlusion_segments と同期させること (板を動かしたら両方更新):
      partition_a: (-3.0, 1.0) - (-1.0, 1.0)
      partition_b: ( 0.5,-1.0) - ( 2.5,-1.0)
      partition_c: ( 4.0, 0.5) - ( 4.0, 2.5)
  ロボットスポーン: (-5.0, -3.0)
-->
<sdf version="1.6">
  <world name="lost_reacquire">

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 外周壁 (内寸 12.0 × 8.0) -->
    <model name="wall_south">
      <static>true</static><pose>0 -4.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12.2 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>0 4.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12.2 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-6.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 8.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>6.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 8.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>

    <!-- 自立遮蔽板 3 枚 (occlusion_segments と同期必須) -->
    <model name="partition_a">
      <static>true</static><pose>-2.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.15 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.0 0.15 2.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="partition_b">
      <static>true</static><pose>1.5 -1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.15 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.0 0.15 2.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="partition_c">
      <static>true</static><pose>4.0 1.5 1.0 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.15 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.0 0.15 2.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- 試験員模擬シリンダー (person_mover が動かす) -->
    <model name="inspector">
      <static>true</static>
      <pose>-4.0 -2.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
