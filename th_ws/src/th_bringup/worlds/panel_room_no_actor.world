<?xml version="1.0"?>
<!--
  panel_room_no_actor.world
  ─────────────────────────
  walk.dae が環境にない場合の代替ワールド。
  試験員を移動する cylinder モデルで模擬する。
  gazebo_person_relay.py は /gazebo/model_states から
  "person_cylinder" モデルの位置を読む。
  
  cylinder を動かすには別ターミナルで:
    ros2 service call /gazebo/set_model_state \
      gazebo_msgs/srv/SetModelState \
      "{model_state: {model_name: person_cylinder, pose: {position: {x: 1.0, y: 2.5, z: 0.9}}}}"
  または person_mover.py で自動移動させる。
-->
<sdf version="1.6">
  <world name="panel_room">

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- gazebo_ros_state プラグイン -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 壁 -->
    <model name="wall_south">
      <static>true</static><pose>0 -4.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>0 4.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-5.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 8.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>5.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 8.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>

    <!-- 通路仕切り -->
    <model name="partition_west">
      <static>true</static><pose>-1.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.15 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.15 2.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- 配電盤 -->
    <model name="panel_01">
      <static>true</static><pose>-3.0 3.55 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.2 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.2 1.5</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>
    <model name="panel_02">
      <static>true</static><pose>0.0 3.55 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.2 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.2 1.5</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>
    <model name="panel_03">
      <static>true</static><pose>3.0 3.55 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.2 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.2 1.5</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>

    <!-- 試験員模擬: 動く cylinder (walk.dae 代替) -->
    <!-- static=true にすることで重力・物理による転倒を防ぎ、         -->
    <!-- set_entity_state で確実に移動できる。LiDAR 当たり判定は維持。 -->
    <model name="inspector">
      <static>true</static>
      <pose>0.0 2.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Gazebo の set_model_state サービスで位置を制御するか
           person_mover.py で自動制御する -->
    </model>

  </world>
</sdf>
