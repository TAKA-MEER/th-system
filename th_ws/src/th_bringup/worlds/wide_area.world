<?xml version="1.0"?>
<!--
  wide_area.world
  ───────────────
  広所追従シナリオ (scenario:=wide_area) 用ワールド。
  内寸 20×16 m のホール。LiDAR レンジ 12 m でも常に特徴が見えるよう、
  柱 (0.3 m 角) を 8 m 間隔以内で非対称に配置し、SLAM/AMCL の位置曖昧性を
  避ける。北東に壁の凹み (アルコーブ) を 1 つ設ける。
  広所向け FOLLOWING_MAPLESS パラメータ (stop 1.0 / resume 1.3 / obstacle 1.0)
  の先行検証を想定。
  ロボットスポーン: (-8.0, -6.0)
-->
<sdf version="1.6">
  <world name="wide_area">

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 外周壁 (内寸 20.0 × 16.0) -->
    <model name="wall_south">
      <static>true</static><pose>0 -8.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.2 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>0 8.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.2 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-10.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 16.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 16.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>10.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 16.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 16.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>

    <!-- アルコーブ (北東の壁凹み特徴): 北壁から南へ突き出す短壁 2 枚 -->
    <model name="alcove_west">
      <static>true</static><pose>5.0 7.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 2.0 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.0 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="alcove_east">
      <static>true</static><pose>8.0 7.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 2.0 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.0 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>

    <!-- 柱 (0.3 m 角・高さ 3 m)。非対称配置・間隔 8 m 以内 -->
    <model name="pillar_01">
      <static>true</static><pose>-6.0 -4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="pillar_02">
      <static>true</static><pose>-7.0 3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="pillar_03">
      <static>true</static><pose>-1.0 6.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="pillar_04">
      <static>true</static><pose>0.0 -2.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="pillar_05">
      <static>true</static><pose>4.0 -6.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="pillar_06">
      <static>true</static><pose>6.0 2.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="pillar_07">
      <static>true</static><pose>8.5 -3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- 試験員模擬シリンダー (person_mover が動かす) -->
    <model name="inspector">
      <static>true</static>
      <pose>-6.0 -6.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 回避検証用の動く障害物 (デフォルトでは obstacle_mover 無効・待機位置に静置) -->
    <model name="wanderer">
      <pose>9.0 7.0 0.85 0 0 0</pose>
      <link name="link">
        <inertial><mass>70.0</mass>
          <inertia><ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.0</iyy><iyz>0</iyz><izz>0.3</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
