          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg3v"><pose>-0.18 0.18 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.45</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg4v"><pose>-0.18 -0.18 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.45</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="seat"><pose>0 0 0.47 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.04</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>
    <model name="chair_02">
      <static>true</static><pose>0.0 -0.5 0 0 0 0.8</pose>
      <link name="link">
        <collision name="leg1"><pose>0.18 0.18 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.45</length></cylinder></geometry></collision>
        <collision name="leg2"><pose>0.18 -0.18 0.225 0 0 0</pose>
