    <!-- 柱 -->
    <model name="pillar_01">
      <static>true</static><pose>-4.0 -2.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 3.0</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material></visual>
