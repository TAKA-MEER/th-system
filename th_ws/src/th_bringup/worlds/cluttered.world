        <visual name="leg1v"><pose>0.55 0.3 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg2v"><pose>0.55 -0.3 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg3v"><pose>-0.55 0.3 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="leg4v"><pose>-0.55 -0.3 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <visual name="top"><pose>0 0 0.72 0 0 0</pose>
          <geometry><box><size>1.2 0.7 0.04</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- 椅子: 脚 4 本 (r0.02) + 座面 (visual のみ) -->
    <model name="chair_01">
      <static>true</static><pose>-2.5 0.6 0 0 0 0</pose>
      <link name="link">
        <collision name="leg1"><pose>0.18 0.18 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.45</length></cylinder></geometry></collision>
        <collision name="leg2"><pose>0.18 -0.18 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.45</length></cylinder></geometry></collision>
        <collision name="leg3"><pose>-0.18 0.18 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.45</length></cylinder></geometry></collision>
        <collision name="leg4"><pose>-0.18 -0.18 0.225 0 0 0</pose>
