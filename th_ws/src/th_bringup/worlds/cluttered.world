    <!-- 試験員模擬シリンダー (person_mover が動かす) -->
    <model name="inspector">
      <static>true</static>
      <pose>-1.0 2.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 回避検証用の動く障害物 (obstacle_mover が動かす) -->
    <model name="wanderer">
      <pose>2.0 -3.2 0.85 0 0 0</pose>
      <link name="link">
        <inertial><mass>70.0</mass>
          <inertia><ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.0</iyy><iyz>0</iyz><izz>0.3</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

