<?xml version="1.0"?>
<package format="3">
  <name>th_safety</name>
  <version>0.1.0</version>
  <description>safety_monitor ノード — E-Stop・フォルト検知・twist_mux ロック</description>
  <maintainer email="dev@example.com">TH Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>th_system_msgs</depend>
  <!-- obstacle_limiter（WP-SAFE-03）: 起動時に 1 度だけ base_link<-laser_link
       を取得するために要る（names.md §1.2）。tf2 は tf2::TransformException /
       tf2::getYaw / tf2::durationFromSec を直接使うため明示的に依存させる。 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <!-- jog_gate（WP-SAFE-04）: attributes.yaml（th_state と同じファイル）を
       ament_index_cpp で指し、yaml-cpp で読むのに要る。 -->
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>
  <!-- jog_gate は実行時に th_state の share/config/attributes.yaml を読む
       （J-4: th_state の jog_allowed と同じファイル）。ビルドには要らないが
       実行時には必ず要るので exec_depend で表明する。 -->
  <exec_depend>th_state</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
