<?xml version="1.0"?>
<package format="3">
  <name>th_safety</name>
  <version>0.1.0</version>
  <description>safety_monitor ノード — E-Stop・フォルト検知・twist_mux ロック</description>
  <maintainer email="dev@example.com">TH Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>th_system_msgs</depend>
  <!-- obstacle_limiter（WP-SAFE-03）: 起動時に 1 度だけ base_link<-laser_link
       を取得するために要る（names.md §1.2）。tf2 は tf2::TransformException /
       tf2::getYaw / tf2::durationFromSec を直接使うため明示的に依存させる。 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>twist_mux</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
