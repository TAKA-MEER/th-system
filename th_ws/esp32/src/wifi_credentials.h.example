#pragma once

// ============================================================
// WiFi / WebSocket 接続情報 (実値)
//
// このファイルを wifi_credentials.h という名前でコピーし、
// 実際の値を書き込むこと。wifi_credentials.h は .gitignore 対象。
//
//   cp src/wifi_credentials.h.example src/wifi_credentials.h
//
// ── 現行の構成 (2026-08-20 以降) ──────────────────────────
//   Raspberry Pi が親機 (AP・2.4GHz ch1)、ESP32 と PC はどちらも子機。
//
//     ESP32 ─┐
//            ├─→ Raspberry Pi (AP) ←─ PC (WebSocket サーバ)
//     LiDAR ─┘   ※LiDAR は Pi 上で動く
//
//   以前は ESP32 自身を親機にしていたが (WIFI_AP_MODE 1)、負荷時に
//   ESP32 の無線が 600ms 単位で丸ごと停止することが実測で判明したため
//   親機の役目を降ろした。受信ギャップの最悪値が 1920ms → 300ms。
//   経緯: docs/AP選定検証レポート.md
//
//   ★ 親機側は WPA2/CCMP に固定し、管理フレーム保護 (802.11w / PMF) を
//     無効にすること。PMF が有効だと ESP32 (Arduino) は接続要求すら
//     送れず、しかもシールド基板ではシリアルログが読めないため
//     原因の切り分けが極めて難しい。手順: th_ws/scripts/rpi_setup_ap.sh
// ============================================================

// ── 子機として接続する親機 (現行は Raspberry Pi の AP) ──
#define WIFI_SSID         "your-ap-ssid"
#define WIFI_PASSWORD     "your-ap-passphrase"

// esp32_bridge (PC 側) が WebSocket サーバーを bind しているアドレス。
// 親機のサブネット上での PC の IP を指定する。
// (rpi_setup_ap.sh の既定では 192.168.5.0/24。PC には固定 IP を振る)
#define WS_SERVER_HOST    "192.168.5.50"
#define WS_SERVER_PORT    8766

// ── AP モード (ESP32 自身を親機にする旧構成) ────────────────
// 0 = 子機 (現行)。1 に戻すと ESP32 が親機になるが、上記の理由により
// 常用しないこと。台上で PC と 1 対 1 で繋ぐときの退避手段としてのみ残す。
#define WIFI_AP_MODE      0
#define AP_SSID           "your-ap-ssid"
#define AP_PASSWORD       "your-ap-password"   // WPA2は8文字以上必須
