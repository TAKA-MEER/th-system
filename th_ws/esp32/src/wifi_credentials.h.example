#pragma once

// ============================================================
// WiFi / WebSocket 接続情報 (実値)
//
// このファイルを wifi_credentials.h という名前でコピーし、
// 実際の値を書き込むこと。wifi_credentials.h は .gitignore 対象。
//
//   cp src/wifi_credentials.h.example src/wifi_credentials.h
// ============================================================

#define WIFI_SSID         "your-hotspot-ssid"
#define WIFI_PASSWORD     "your-hotspot-password"

// esp32_bridge (PC 側) が WebSocket サーバーを bind しているアドレス。
// PC のモバイルホットスポートのゲートウェイ IP を指定する
// (Windows モバイルホットスポットの場合、一般的に 192.168.137.1)。
#define WS_SERVER_HOST    "192.168.137.1"
#define WS_SERVER_PORT    8766

// ── AP モード (ESP32自身をアクセスポイント化し、PC/ラズパイ双方が
//    クライアントとして接続する構成。1で有効、0で既存のSTAモード) ──
#define WIFI_AP_MODE      0
#define AP_SSID           "your-ap-ssid"
#define AP_PASSWORD       "your-ap-password"   // WPA2は8文字以上必須
