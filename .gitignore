th_ws/esp32/lib/
ESP32-test/.pio/

# Web UI (Vite/React)
node_modules/
dist/
.vite/

# Docker: 個人環境向けオーバーライド（usbipd の COM ポート等、実機依存の設定）
th_ws/docker-compose.override.yml

# 音声: 話者オーディションの生成物（聞き比べ用の使い捨て。scripts/voice_audition.py で再生成できる）
th_ws/voice_audition/

# DR-SPAAM 重みファイル（手動DL、README参照。360MBありコミットしない）
th_ws/dr_spaam_weights/*
!th_ws/dr_spaam_weights/.gitkeep

# 実行時データ（試験場地図・教示経路・校正値・生成パラメータ・ログ。個体ごとに異なり
# コミットしない。DetailedDesign-names.md §9.2 / WP-PARAM-02）
th_ws/data/*
!th_ws/data/.gitkeep

