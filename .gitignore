# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# ROS2 / colcon ビルド成果物
th_ws/build/
th_ws/install/
th_ws/log/

# ESP32 / PlatformIO
th_ws/esp32/.pio/
# micro_ros_arduino は release zip を手動展開する外部ライブラリ（README/platformio.ini 参照）
th_ws/esp32/lib/
ESP32-test/.pio/

# Web UI (Vite/React)
node_modules/
dist/
.vite/

# Docker: 個人環境向けオーバーライド（usbipd の COM ポート等、実機依存の設定）
th_ws/docker-compose.override.yml

# 音声: 話者オーディションの生成物（聞き比べ用の使い捨て。scripts/voice_audition.py で再生成できる）
th_ws/voice_audition/

# DR-SPAAM 重みファイル（手動DL、README参照。360MBありコミットしない）
th_ws/dr_spaam_weights/*
!th_ws/dr_spaam_weights/.gitkeep

# エディタ / OS
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

*.vscode

# Playwright: E2E の実行結果（使い捨て。再実行で生成される）
th_ws/web_ui/test-results/
th_ws/web_ui/playwright-report/

# Claude Code のローカル設定（環境依存のため共有しない）
.claude/settings.local.json

# tcpdump のテキスト展開（同ディレクトリの .pcap から tshark で再生成できる）
th_ws/data/**/*_tcpdump.txt

# herdr 用の実装ブリーフ置き場（共有しない）
.briefs/

# 教示経路の記録（実行時に route_recorder が書く。機体・現場ごとの生成物）
th_ws/data/routes/
